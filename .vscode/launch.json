{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Prepare: create test CSV",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/prepare.py",
      "args": ["--create-test-csv"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${command:python.interpreterPath}"
    },
    {
      "name": "Prepare: use test CSV",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/prepare.py",
      "args": ["--use-test-csv"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${command:python.interpreterPath}"
    },
    {
      "name": "Prepare: normal run",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/prepare.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${command:python.interpreterPath}"
    }
  ]
}