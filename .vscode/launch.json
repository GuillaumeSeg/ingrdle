{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Prepare: create test CSV",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/prepare_with_csv.py",
      "args": ["--create-test-csv"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${command:python.interpreterPath}"
    },
    {
      "name": "Prepare: use test CSV",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/prepare_with_csv.py",
      "args": ["--use-test-csv"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${command:python.interpreterPath}"
    },
    {
      "name": "Prepare: Normal CSV run",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/prepare_with_csv.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${command:python.interpreterPath}"
    },
    {
      "name": "Prepare: API search",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/prepare_with_api.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${command:python.interpreterPath}"
    },
    {
      "name": "Prepare: JSONL download",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/download_jsonl.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${command:python.interpreterPath}"
    },
    {
      "name": "Prepare: Read All JSONL & select products",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/prepare_with_json.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${command:python.interpreterPath}"
    },
    {
      "name": "Prepare: Read JSONL max products & select products",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/prepare_with_json.py",
      "args": ["--max-products", "55000"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${command:python.interpreterPath}"
    },
    {
      "name": "Prepare: Generate questions for date",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/generate_questions.py",
      "args": ["--date", "2026-10-21"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${command:python.interpreterPath}"
    },
    {
      "name": "Generate: Question batch (45)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/generate_batch.py",
      "args": ["--count", "${input:batchQuestionCount}"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "python": "${command:python.interpreterPath}"
    }
  ],
  "inputs": [
    {
      "id": "batchQuestionCount",
      "type": "promptString",
      "description": "Number of questions in the batch",
      "default": "45"
    }
  ]
}